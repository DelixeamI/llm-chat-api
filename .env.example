APP_ENV=local
LOG_LEVEL=INFO

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# qwen3 и другие reasoning-модели по умолчанию долго «размышляют»; none отключает это
OLLAMA_REASONING_EFFORT=none

# Жёсткий предел на один вызов модели, секунды
LLM_TIMEOUT_SECONDS=60

# Повторы только для временных сбоев: 429, 502, 503, 504, таймауты и ошибки соединения
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=8

# Максимум одновременных вызовов модели на процесс
LLM_MAX_CONCURRENCY=5

# PostgreSQL в docker-compose; порт хоста отличается от 5432, чтобы не конфликтовать с локальной базой
POSTGRES_USER=llm_chat
POSTGRES_PASSWORD=llm_chat
POSTGRES_DB=llm_chat
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://llm_chat:llm_chat@127.0.0.1:5433/llm_chat

# Redis в docker-compose: только временные данные с TTL, без сохранения на диск
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
# Соединений с Redis на процесс; остальные запросы ждут свободное
REDIS_MAX_CONNECTIONS=20
# Предел на подключение, команду и ожидание соединения из пула, секунды
REDIS_TIMEOUT_SECONDS=0.5

# Кэш ответов на детерминированные запросы (temperature 0) и срок жизни записи, секунды
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=3600

# Дополнительные генерации, если модель вернула непригодный структурированный ответ
STRUCTURED_MAX_RETRIES=1

# Условные цены за миллион токенов для учёта стоимости и курс для отчётов в рублях
MODEL_PRICES={"qwen3:8b": {"input_per_million_usd": "0.05", "output_per_million_usd": "0.40"}}
USD_TO_RUB=95

# Контекстное окно: должно совпадать с настройкой сервера (Ollama по умолчанию — 4096)
MODEL_CONTEXT_LIMITS={"qwen3:8b": 4096}
DEFAULT_CONTEXT_LIMIT=4096
# reject — отказать в слишком длинном запросе; truncate_oldest — выбросить старые ходы диалога
CONTEXT_OVERFLOW_STRATEGY=reject
