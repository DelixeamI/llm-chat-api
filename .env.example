APP_ENV=local
LOG_LEVEL=INFO
# json — для сборщиков логов, text — читать в терминале
LOG_FORMAT=json

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# qwen3 и другие reasoning-модели по умолчанию долго «размышляют»; none отключает это
OLLAMA_REASONING_EFFORT=none

# Жёсткий предел на один вызов модели, секунды
LLM_TIMEOUT_SECONDS=60

# Повторы только для временных сбоев: 429, 502, 503, 504, таймауты и ошибки соединения
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=8

# Максимум одновременных вызовов модели на процесс
LLM_MAX_CONCURRENCY=5

# PostgreSQL в docker-compose; порт хоста отличается от 5432, чтобы не конфликтовать с локальной базой
POSTGRES_USER=llm_chat
POSTGRES_PASSWORD=llm_chat
POSTGRES_DB=llm_chat
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://llm_chat:llm_chat@127.0.0.1:5433/llm_chat

# Redis в docker-compose: только временные данные с TTL, без сохранения на диск
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
# Соединений с Redis на процесс; остальные запросы ждут свободное
REDIS_MAX_CONNECTIONS=20
# Предел на подключение, команду и ожидание соединения из пула, секунды
REDIS_TIMEOUT_SECONDS=0.5

# Кэш ответов на детерминированные запросы (temperature 0) и срок жизни записи, секунды
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=3600

# Дополнительные генерации, если модель вернула непригодный структурированный ответ
STRUCTURED_MAX_RETRIES=1

# Условные цены за миллион токенов для учёта стоимости и курс для отчётов в рублях
MODEL_PRICES={"qwen3:8b": {"input_per_million_usd": "0.05", "output_per_million_usd": "0.40"}}
USD_TO_RUB=95

# Контекстное окно: должно совпадать с настройкой сервера (Ollama по умолчанию — 4096)
MODEL_CONTEXT_LIMITS={"qwen3:8b": 4096}
DEFAULT_CONTEXT_LIMIT=4096
# reject — отказать в слишком длинном запросе; truncate_oldest — выбросить старые ходы диалога
CONTEXT_OVERFLOW_STRATEGY=reject

# Ключи доступа к API: JSON-список {client, key, scopes}. Ключ — не короче 16 символов,
# сгенерируйте случайный: python -c "import secrets; print(secrets.token_urlsafe(32))"
# scopes: chat — модель и свои диалоги; admin — расход, стоимость, кэш и чтение любых диалогов.
# Без ключей все защищённые эндпоинты отвечают 401. Настоящие ключи держите только в .env.
# API_KEYS=[{"client": "my-app", "key": "ЗАМЕНИТЕ-НА-СЛУЧАЙНЫЙ-КЛЮЧ", "scopes": ["chat"]}]

# Лимит запросов на клиента к моделям (/v1/chat, /v1/chat/stream, /v1/chat/structured):
# не больше RATE_LIMIT_REQUESTS за скользящее окно RATE_LIMIT_WINDOW_SECONDS, счёт в Redis
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Idempotency-Key для /v1/chat и /v1/chat/structured: повтор с тем же ключом возвращает первый
# ответ. TTL — сколько хранится готовый ответ; LOCK — сколько запущенный запрос держит ключ
# (должно быть больше самого долгого запроса)
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_SECONDS=600

# Трассировка OpenTelemetry. По умолчанию выключена. OTLP — адрес коллектора или Jaeger,
# CONSOLE печатает span-ы в stderr, SAMPLE_RATIO — доля трассируемых запросов
TRACING_ENABLED=false
# TRACING_OTLP_ENDPOINT=http://localhost:4318/v1/traces
TRACING_CONSOLE=false
TRACING_SAMPLE_RATIO=1.0

# Готовность (/ready): предел ожидания каждой зависимости и срок, на который ответ переиспользуется,
# чтобы частые проверки оркестратора не нагружали базу и Redis. Redis по умолчанию необязателен:
# без него экземпляр «деградировал», но продолжает отвечать
READY_TIMEOUT_SECONDS=1
READY_CACHE_SECONDS=2
READY_REDIS_REQUIRED=false

# Запуск в контейнерах (docker compose up): порт приложения на хосте и адрес модели.
# По умолчанию — Ollama на хосте. Для заглушки модели: COMPOSE_LLM_URL=http://fake-llm:9000/v1
# и docker compose --profile fake-llm up
API_PORT=8000
# COMPOSE_LLM_URL=http://host.docker.internal:11434/v1
