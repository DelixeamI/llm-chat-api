APP_ENV=local
LOG_LEVEL=INFO

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# qwen3 и другие reasoning-модели по умолчанию долго «размышляют»; none отключает это
OLLAMA_REASONING_EFFORT=none

# Жёсткий предел на один вызов модели, секунды
LLM_TIMEOUT_SECONDS=60

# Повторы только для временных сбоев: 429, 502, 503, 504, таймауты и ошибки соединения
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=8
